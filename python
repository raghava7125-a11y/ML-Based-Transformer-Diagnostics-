# ==========================================
# Cell 1: Import Libraries
# ==========================================
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os

from sklearn.ensemble import RandomForestRegressor, IsolationForest
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.preprocessing import StandardScaler

# Create directories for saving outputs if they don't exist
os.makedirs('data', exist_ok=True)
os.makedirs('images', exist_ok=True)

# ==========================================
# Cell 2: Synthetic Data Generation (or Load Data)
# ==========================================
def generate_transformer_data(n_samples=1000):
    np.random.seed(42)
    
    # Base operational parameters
    voltage = np.random.normal(11000, 100, n_samples) # 11kV distribution
    current = np.random.normal(150, 40, n_samples)    # Amperes
    power_factor = np.random.uniform(0.85, 0.99, n_samples)
    
    # Calculate Power
    apparent_power = (voltage * current) / 1000 # kVA
    active_power = apparent_power * power_factor # kW
    reactive_power = apparent_power * np.sin(np.arccos(power_factor)) # kVAR
    
    # Load factor (ratio of current to rated current, assume 250A rated)
    load_factor = current / 250
    
    # Temperatures (correlated with load)
    tot = 40 + (load_factor * 35) + np.random.normal(0, 3, n_samples) # Top Oil Temp
    wti = tot + 10 + (load_factor * 15) + np.random.normal(0, 2, n_samples) # Winding Temp
    
    # Losses
    core_loss = np.random.normal(2.5, 0.1, n_samples) # Fixed losses in kW
    copper_loss = (load_factor ** 2) * 12.0 + np.random.normal(0, 0.2, n_samples) # I^2R losses in kW
    
    # True Efficiency
    total_losses = core_loss + copper_loss
    efficiency = (active_power / (active_power + total_losses)) * 100
    
    df = pd.DataFrame({
        'Voltage_V': voltage,
        'Current_A': current,
        'Active_Power_kW': active_power,
        'Reactive_Power_kVAR': reactive_power,
        'Power_Factor': power_factor,
        'TOT_C': tot,
        'WTI_C': wti,
        'Core_Loss_kW': core_loss,
        'Copper_Loss_kW': copper_loss,
        'Efficiency_Pct': efficiency
    })
    
    # Inject synthetic anomalies (overheating or efficiency drops)
    anomaly_indices = np.random.choice(n_samples, size=int(0.05 * n_samples), replace=False)
    df.loc[anomaly_indices, 'TOT_C'] += np.random.uniform(15, 25, len(anomaly_indices))
    df.loc[anomaly_indices, 'Efficiency_Pct'] -= np.random.uniform(2, 5, len(anomaly_indices))
    
    return df

# Load or generate data
try:
    df = pd.read_csv('data/transformer_operational_data.csv')
    print("Loaded existing dataset.")
except FileNotFoundError:
    print("Dataset not found. Generating synthetic operational data...")
    df = generate_transformer_data(1500)
    df.to_csv('data/transformer_operational_data.csv', index=False)

df.head()

# ==========================================
# Cell 3: Data Preprocessing
# ==========================================
# Features for Efficiency Prediction
X_eff = df[['Voltage_V', 'Current_A', 'Active_Power_kW', 'Power_Factor', 'TOT_C', 'WTI_C']]
y_eff = df['Efficiency_Pct']

# Scale features
scaler = StandardScaler()
X_eff_scaled = scaler.fit_transform(X_eff)

X_train, X_test, y_train, y_test = train_test_split(X_eff_scaled, y_eff, test_size=0.2, random_state=42)

# ==========================================
# Cell 4: Efficiency Prediction (Random Forest)
# ==========================================
rf_model = RandomForestRegressor(n_estimators=100, max_depth=10, random_state=42)
rf_model.fit(X_train, y_train)

y_pred = rf_model.predict(X_test)

# Metrics
mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)
print(f"Random Forest Performance:")
print(f"Mean Squared Error: {mse:.4f}")
print(f"R-squared Score: {r2:.4f}")

# ==========================================
# Cell 5: Visualize Efficiency Prediction
# ==========================================
plt.figure(figsize=(10, 6))
plt.scatter(y_test, y_pred, alpha=0.6, edgecolors='w', color='teal')
plt.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2)
plt.title('Transformer Efficiency: Actual vs Predicted')
plt.xlabel('Actual Efficiency (%)')
plt.ylabel('Predicted Efficiency (%)')
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('images/efficiency_curve.png')
plt.show()

# ==========================================
# Cell 6: Anomaly Detection (Isolation Forest)
# ==========================================
# Select features indicative of health anomalies (Temperature vs Power)
X_anom = df[['Active_Power_kW', 'TOT_C', 'WTI_C']]

# Train Isolation Forest (assuming ~5% anomaly contamination)
iso_forest = IsolationForest(n_estimators=100, contamination=0.05, random_state=42)
df['Anomaly_Flag'] = iso_forest.fit_predict(X_anom)

# Remap flags: -1 (Anomaly) -> 1, 1 (Normal) -> 0 for easier plotting
df['Anomaly_Flag'] = df['Anomaly_Flag'].map({1: 0, -1: 1})

num_anomalies = df['Anomaly_Flag'].sum()
print(f"Anomalies detected: {num_anomalies} out of {len(df)} records")

# ==========================================
# Cell 7: Visualize Anomalies
# ==========================================
normal_data = df[df['Anomaly_Flag'] == 0]
anomaly_data = df[df['Anomaly_Flag'] == 1]

plt.figure(figsize=(10, 6))
plt.scatter(normal_data['Active_Power_kW'], normal_data['TOT_C'], 
            label='Normal Operation', color='royalblue', alpha=0.5)
plt.scatter(anomaly_data['Active_Power_kW'], anomaly_data['TOT_C'], 
            label='Anomalies (Overheating)', color='crimson', edgecolors='black', s=60)

plt.title('Anomaly Detection: Top Oil Temperature vs Active Power')
plt.xlabel('Active Power (kW)')
plt.ylabel('Top Oil Temperature (°C)')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('images/anomalies_plot.png')
plt.show()
